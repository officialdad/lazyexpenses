# Copy to .env and fill in what you have. .env is gitignored - keep it that way.
# Everything here is optional except the statement passwords for banks you actually
# hold, and the Gmail pair if you want mail fetched automatically.
#
# YOU DO NOT HAVE TO USE THIS FILE AT ALL (#40). Start the app with an empty volume and
# it opens on a setup screen: upload one statement from the browser and it becomes a
# dashboard. Everything below except PORT and APP_PASSWORD can be typed in there instead,
# and lands on the volume as settings.json. Anything you DO set here wins over what the
# UI holds and shows up in it as locked, so an existing .env keeps behaving exactly as it
# did. Secrets only ever go IN through the UI - the API never hands one back.

# ---- the app ----
PORT=8000

# ---- locking the app with a password ----
# CHANGE THIS ONE NOW, BEFORE YOU START ANYTHING. The value below is printed in this
# file, this file is in a public repo, and so anybody who has ever read the repo already
# knows it. It is here only so that a fresh `docker compose up` is CLOSED instead of wide
# open - it is a placeholder, not a password. Leave it and the server prints a warning on
# every boot and the Settings screen nags you until you change it.
#
# Blank = no login at all: anyone who can reach the port sees every transaction and
# balance, and can point your reminders at their own chat. Set it and the web app asks
# for this one password once per device, and the API answers nothing without it. There
# are no accounts - one password, one app.
# If you also run fetch_mail.py by hand, give it the same value so /ingest lets it in.
APP_PASSWORD=changeme@123

# ---- statement passwords ----
# One per bank, named after the filename prefix. Set only the banks you have; an
# already-unlocked PDF parses whether or not its variable is set. Each bank derives
# your password from something like your IC or date of birth - check the covering email.
CC_PW_MAYBANK=
CC_PW_CIMB=
CC_PW_SC=
CC_PW_ALLIANCE=
CC_PW_HSBC=
CC_PW_RHB=

# ---- fetching statements from Gmail ----
# Needs 2-Step Verification on, then an app password from
# https://myaccount.google.com/apppasswords - never your real login password.
# Both blank = the fetch service does nothing.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=CC
# Seconds between mailbox checks. Read per tick since #40 - no restart needed.
FETCH_POLL=3600

# ---- bill reminders ----
# Nothing here is needed for the DEFAULT transport. Open the app, press "Remind me" next
# to the bills and allow notifications - the signing key is generated on the volume by
# itself. Needs https:// or http://localhost, and on iPhone the app has to be installed
# to the Home Screen first.
#
# Telegram is the optional fallback, for a desktop you never install the app on. Token
# from @BotFather; chat id is your own chat with that bot. Message the bot once first -
# Telegram will not let a bot open a conversation. Both blank = Telegram off. Turning on
# both still sends ONE message per bill.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# All three are read per tick since #40, so changing one takes effect on the next check.
REMIND_DAYS=3
REMIND_HOUR=9
# REMIND_TEMPLATE=<b>{bank}</b> RM{amount} due {due} ({when})
# Contact address the push services see; nothing is ever emailed to it.
# VAPID_SUBJECT=mailto:you@example.com
