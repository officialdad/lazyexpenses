# Copy to .env and fill in what you have. .env is gitignored - keep it that way.
# Everything here is optional except the statement passwords for banks you actually
# hold, and the Gmail pair if you want mail fetched automatically.

# ---- the app ----
PORT=8000

# ---- statement passwords ----
# One per bank, named after the filename prefix. Set only the banks you have; an
# already-unlocked PDF parses whether or not its variable is set. Each bank derives
# your password from something like your IC or date of birth - check the covering email.
CC_PW_MAYBANK=
CC_PW_CIMB=
CC_PW_SC=
CC_PW_ALLIANCE=
CC_PW_HSBC=
CC_PW_RHB=

# ---- fetching statements from Gmail ----
# Needs 2-Step Verification on, then an app password from
# https://myaccount.google.com/apppasswords - never your real login password.
# Both blank = the fetch service does nothing.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=CC
FETCH_POLL=3600

# ---- bill reminders over Telegram ----
# Token from @BotFather; chat id is your own chat with that bot. Message the bot once
# first - Telegram will not let a bot open a conversation. Both blank = reminders off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMIND_DAYS=3
REMIND_HOUR=9
# REMIND_TEMPLATE=<b>{bank}</b> RM{amount} due {due} ({when})
